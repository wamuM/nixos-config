#!/usr/bin/env python3

import os
import sys
import subprocess
from pathlib import Path
from datetime import datetime


SCREENSHOT_DIR = Path.home() / "Pictures" / "Screenshots"


def push_option(key, value):
    line = f"\0{key}\x1f{value}\n"
    sys.stdout.buffer.write(line.encode("ascii"))


def push_entry(row, metadata=None):
    line = f"{row}"

    if metadata is not None:
        first = True

        for key, value in metadata.items():
            if first:
                line += "\0"
                first = False
            else:
                line += "\x1f"

            line += f"{key}\x1f{value}"

    line += "\n"
    sys.stdout.buffer.write(line.encode("utf-8"))


def take_screenshot(*args):
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)

    filename = datetime.now().strftime("%Y-%m-%d_%H-%M-%S.png")
    path = SCREENSHOT_DIR / filename

    result = subprocess.run(
        ["maim", *args],
        stdout=subprocess.PIPE,
        check=True,
    )

    path.write_bytes(result.stdout)

    subprocess.Popen(
        [
            "xclip",
            "-selection", "clipboard",
            "-t", "image/png",
            "-i", str(path),
        ],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    relative_path = path.relative_to(Path.home())

    subprocess.run([
        "notify-send",
        "Screenshot taken",
        f"Saved in ~/{relative_path}\nand in clipboard",
    ])

    return path


def take_screenshot_detached(*args):
    """
    Start another instance of this script and immediately return.

    This is necessary for `maim -s`: the Rofi script must exit first
    so that Rofi releases its mouse grab.
    """
    subprocess.Popen(
        [
            sys.executable,
            __file__,
            "--take-screenshot",
            *args,
        ],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True,
    )


def get_windows():
    result = subprocess.run(
        [
            "awesome-client",
            (
                "local t={}; "
                "for _,c in ipairs(client.get()) do "
                "if c:isvisible() then "
                'table.insert(t, c.window .. "\\t" .. (c.name or ("[Unnamed] ".. c.window))); '
                "end; "
                "end; "
                'return table.concat(t, "\\n")'
            ),
        ],
        capture_output=True,
        text=True,
        check=True,
    )

    windows = []

    for line in result.stdout.splitlines():
        window_id, title = line.split("\t", 1)

        windows.append({
            "id": window_id,
            "title": title,
        })

    return windows

def get_current_window():
    result = subprocess.run(
        [
            "awesome-client",
            "return tostring(client.focus and client.focus.window)",
        ],
        capture_output=True,
        text=True,
        check=True,
    )

    return result.stdout.strip().removeprefix("string ").strip('"')


def window_menu():
    push_option("no-custom", "true")
    push_option("prompt", "Window")
    push_option("data", "window")

    windows = get_windows()

    push_entry(
        "[Current window]",
        {"info": get_current_window()},
    )

    for window in windows:
        push_entry(
            window["title"],
            {"info": window["id"]},
        )


def main():
    retv = int(os.getenv("ROFI_RETV", 0))
    data = os.getenv("ROFI_DATA")
    info = os.getenv("ROFI_INFO")

    args = sys.argv[1:]

    # ------------------------------------------------------------
    # Detached screenshot process.
    #
    # This runs AFTER the Rofi instance has exited.
    # ------------------------------------------------------------
    if args and args[0] == "--take-screenshot":
        take_screenshot(*args[1:])
        return

    # ------------------------------------------------------------
    # Initial Rofi invocation
    # ------------------------------------------------------------
    if retv == 0:
        push_option("no-custom", "true")
        push_option("prompt", "Screenshot")
        push_option("data", "scope")

        push_entry("Screen")
        push_entry("Selection")
        push_entry("Window")

        return

    # ------------------------------------------------------------
    # User selected something
    # ------------------------------------------------------------
    if retv == 1:

        if data == "scope":
            if not args:
                return

            if args[0] == "Screen":
                take_screenshot_detached()

            elif args[0] == "Selection":
                # Rofi currently owns the mouse grab.
                # Start another process and let this one exit.
                take_screenshot_detached("-s")

            elif args[0] == "Window":
                window_menu()

            else:
                return

        elif data == "screen":
            # Not implemented yet
            return

        elif data == "window":
            take_screenshot("-i", info)

        return


if __name__ == "__main__":
    main()
